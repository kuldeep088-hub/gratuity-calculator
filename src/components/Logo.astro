---
// Logo.astro - Clean Minimalist Brand Logo for Gratuity Calculator
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 128 128"
  width={size}
  height={size}
  class={`shrink-0 select-none ${className}`}
  aria-hidden="true"
>
  <!-- Clean Vercel-style Dark Squircle -->
  <rect width="128" height="128" rx="30" fill="#171717"/>
  <rect x="1" y="1" width="126" height="126" rx="29" fill="none" stroke="#ffffff" stroke-opacity="0.14" stroke-width="1.5"/>

  <!-- Bold, Optically Centered Indian Rupee Vector Mark -->
  <path
    d="M 35 22 H 93 V 31.5 H 72 C 75.2 35.5 77.2 40.5 77.6 46 H 93 V 54.5 H 77.2 C 75.2 66 65.5 74.5 53 75.5 L 85 112 H 68.5 L 38 78 V 69.5 H 51.5 C 59.2 69.5 65.5 64 66.8 54.5 H 35 V 46 H 66.5 C 65.2 38.5 59 33 51.5 31.5 H 35 V 22 Z"
    fill="#ffffff"
  />
</svg>
