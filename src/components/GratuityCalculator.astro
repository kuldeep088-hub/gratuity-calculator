---
// GratuityCalculator.astro
// Mobile-Optimized, Calm & Spacious Gratuity Calculator adhering to DESIGN.md
---

<section id="calculator" class="w-full pt-8 sm:pt-16 pb-12 sm:pb-20 overflow-hidden scroll-mt-20">
  <div class="w-full max-w-5xl mx-auto px-3.5 sm:px-6">
    
    <!-- Hero / Headline -->
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-12">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-[-0.04em] text-[#171717] leading-[1.08] mb-2 sm:mb-3 text-balance">
        Gratuity Calculator
      </h1>
      <p class="text-xs sm:text-base text-[#666] leading-relaxed max-w-lg mx-auto font-normal px-2 text-pretty">
        A clear, accurate calculation for Covered & Non-Covered establishments with Section 10(10) tax exemptions.
      </p>
    </div>

    <!-- Master Calculator Container -->
    <div class="w-full max-w-full bg-white/95 backdrop-blur-xl border border-[#ebebeb] rounded-2xl sm:rounded-3xl p-4 sm:p-7 lg:p-10 shadow-[0_8px_35px_rgba(0,0,0,0.03)] transition-all">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start">
        
        <!-- Left Column: Inputs (7 cols) -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-7">
          
          <!-- Category Segmented Control -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] sm:text-[11px] font-semibold uppercase text-[#8f8f8f] tracking-wider">
                1. Employment Category
              </span>
              <span id="category-description-text" class="text-[10px] sm:text-[11px] text-[#8f8f8f] truncate max-w-[240px] text-right hidden sm:block">
                Covered under Act (26 days base)
              </span>
            </div>
            <div role="tablist" aria-label="Employment Category" class="grid grid-cols-3 gap-1 p-1 bg-[#f5f5f5] rounded-xl border border-[#ebebeb]">
              <button
                type="button"
                id="tab-covered"
                role="tab"
                aria-selected="true"
                class="category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs min-h-[42px] flex flex-col items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                data-category="covered"
              >
                <span class="leading-none">Covered</span>
                <span class="block text-[9px] sm:text-[10px] text-[#8f8f8f] font-mono mt-0.5">15/26 days</span>
              </button>
              <button
                type="button"
                id="tab-not-covered"
                role="tab"
                aria-selected="false"
                class="category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] min-h-[42px] flex flex-col items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                data-category="not-covered"
              >
                <span class="leading-none">Not Covered</span>
                <span class="block text-[9px] sm:text-[10px] text-[#8f8f8f] font-mono mt-0.5">15/30 days</span>
              </button>
              <button
                type="button"
                id="tab-govt"
                role="tab"
                aria-selected="false"
                class="category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] min-h-[42px] flex flex-col items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                data-category="govt"
              >
                <span class="leading-none">Govt</span>
                <span class="block text-[9px] sm:text-[10px] text-[#8f8f8f] font-mono mt-0.5">Tax-Free</span>
              </button>
            </div>
          </div>

          <!-- Monthly Salary Section -->
          <div class="pt-2 border-t border-[#f0f0f0] space-y-3.5">
            <div class="flex items-center justify-between">
              <div>
                <label for="salary-input" class="font-medium text-xs sm:text-sm text-[#171717]">
                  2. Monthly Salary (Basic + DA)
                </label>
                <p class="text-[10px] sm:text-[11px] text-[#8f8f8f] mt-0.5">
                  Last drawn basic salary and dearness allowance.
                </p>
              </div>
              <button
                type="button"
                id="toggle-ctc-helper"
                class="text-xs font-mono text-[#0070f3] hover:underline cursor-pointer flex items-center gap-1 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0070f3] rounded"
              >
                CTC Splitter ▾
              </button>
            </div>

            <!-- CTC helper drawer -->
            <div id="ctc-helper-drawer" class="hidden p-3.5 bg-[#fafafa] border border-[#ebebeb] rounded-xl text-xs space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="font-medium text-[#171717]">Estimate Basic from Annual CTC</span>
                <span class="text-[10px] text-[#8f8f8f]">Rule of thumb: 40%–50%</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <input
                  type="number"
                  id="helper-ctc-input"
                  placeholder="Annual CTC (₹) e.g. 1200000"
                  class="w-full px-3 py-2 text-base sm:text-xs bg-white border border-[#ebebeb] rounded-lg focus:outline-none focus:border-[#171717]"
                />
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    id="apply-ctc-40"
                    class="w-1/2 py-2 px-2 bg-white border border-[#ebebeb] rounded-lg text-xs font-medium hover:bg-[#f0f0f0] transition-colors min-h-[38px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                  >
                    Use 40%
                  </button>
                  <button
                    type="button"
                    id="apply-ctc-50"
                    class="w-1/2 py-2 px-2 bg-white border border-[#ebebeb] rounded-lg text-xs font-medium hover:bg-[#f0f0f0] transition-colors min-h-[38px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                  >
                    Use 50%
                  </button>
                </div>
              </div>
            </div>

            <!-- Salary Input + Slider (16px base text prevents mobile iOS zoom) -->
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#8f8f8f] font-mono text-base font-semibold pointer-events-none">₹</span>
              <input
                type="text"
                id="salary-input"
                inputmode="numeric"
                autocomplete="off"
                spellcheck="false"
                value="60,000"
                class="w-full pl-8 pr-4 py-2.5 text-base sm:text-lg font-semibold tracking-tight text-[#171717] bg-[#fafafa] border border-[#ebebeb] rounded-xl focus:outline-none focus:ring-1 focus:ring-[#171717] focus:bg-white transition-all min-h-[44px] tabular-nums"
              />
            </div>

            <div class="pt-1">
              <input
                type="range"
                id="salary-slider"
                min="10000"
                max="500000"
                step="1000"
                value="60000"
                aria-label="Monthly Basic salary and Dearness Allowance"
                aria-valuemin="10000"
                aria-valuemax="500000"
                class="w-full py-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
              />
              <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f] mt-1 tabular-nums">
                <span>₹10,000</span>
                <span>₹2,50,000</span>
                <span>₹5,00,000</span>
              </div>
            </div>

            <!-- Quick Presets (Single Row Horizontal Carousel on Mobile) -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 sm:flex-wrap">
              <span class="text-[11px] text-[#8f8f8f] shrink-0 mr-0.5">Presets:</span>
              <button type="button" class="preset-salary shrink-0 text-[11px] font-mono px-2.5 py-1 bg-[#f5f5f5] active:bg-[#e0e0e0] hover:bg-[#ebebeb] rounded-lg border border-[#e5e5e5] text-[#4d4d4d] transition-colors min-h-[30px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]" data-val="30000">₹30k</button>
              <button type="button" class="preset-salary shrink-0 text-[11px] font-mono px-2.5 py-1 bg-[#f5f5f5] active:bg-[#e0e0e0] hover:bg-[#ebebeb] rounded-lg border border-[#e5e5e5] text-[#4d4d4d] transition-colors min-h-[30px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]" data-val="50000">₹50k</button>
              <button type="button" class="preset-salary shrink-0 text-[11px] font-mono px-2.5 py-1 bg-[#f5f5f5] active:bg-[#e0e0e0] hover:bg-[#ebebeb] rounded-lg border border-[#e5e5e5] text-[#4d4d4d] transition-colors min-h-[30px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]" data-val="75000">₹75k</button>
              <button type="button" class="preset-salary shrink-0 text-[11px] font-mono px-2.5 py-1 bg-[#f5f5f5] active:bg-[#e0e0e0] hover:bg-[#ebebeb] rounded-lg border border-[#e5e5e5] text-[#4d4d4d] transition-colors min-h-[30px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]" data-val="100000">₹1L</button>
              <button type="button" class="preset-salary shrink-0 text-[11px] font-mono px-2.5 py-1 bg-[#f5f5f5] active:bg-[#e0e0e0] hover:bg-[#ebebeb] rounded-lg border border-[#e5e5e5] text-[#4d4d4d] transition-colors min-h-[30px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]" data-val="150000">₹1.5L</button>
            </div>
          </div>

          <!-- Tenure Section -->
          <div class="pt-2 border-t border-[#f0f0f0] space-y-3.5">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-medium text-xs sm:text-sm text-[#171717]">
                  3. Service Tenure
                </span>
                <p class="text-[10px] sm:text-[11px] text-[#8f8f8f] mt-0.5">
                  Total completed service period.
                </p>
              </div>
              <span id="effective-years-badge" class="font-mono text-xs px-2.5 py-1 bg-[#f2f2f2] text-[#171717] rounded-lg font-semibold tabular-nums">
                Effective: 10 Years
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-4">
              <!-- Years -->
              <div class="p-2.5 sm:p-3 bg-[#fafafa] border border-[#ebebeb] rounded-xl space-y-1.5">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-[#4d4d4d] font-medium">Completed Years</span>
                  <span id="years-display" class="font-mono font-bold text-sm text-[#171717] tabular-nums">10 yrs</span>
                </div>
                <input
                  type="range"
                  id="years-slider"
                  min="1"
                  max="45"
                  step="1"
                  value="10"
                  aria-label="Completed service years"
                  aria-valuemin="1"
                  aria-valuemax="45"
                  class="w-full py-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                />
                <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f] tabular-nums">
                  <span>1 yr</span>
                  <span>45 yrs</span>
                </div>
              </div>

              <!-- Months -->
              <div class="p-2.5 sm:p-3 bg-[#fafafa] border border-[#ebebeb] rounded-xl space-y-1.5">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-[#4d4d4d] font-medium">Extra Months</span>
                  <span id="months-display" class="font-mono font-bold text-sm text-[#171717] tabular-nums">0 mos</span>
                </div>
                <input
                  type="range"
                  id="months-slider"
                  min="0"
                  max="11"
                  step="1"
                  value="0"
                  aria-label="Extra months beyond completed years"
                  aria-valuemin="0"
                  aria-valuemax="11"
                  class="w-full py-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717]"
                />
                <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f] tabular-nums">
                  <span>0 mos</span>
                  <span>11 mos</span>
                </div>
              </div>
            </div>

            <!-- Rounding rule status -->
            <div id="rounding-alert-box" class="py-2 px-3 bg-[#fafafa] border border-[#ebebeb] rounded-xl text-xs text-[#4d4d4d] flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span id="rounding-explanation" class="text-[11px] text-[#4d4d4d] truncate">
                  Service of 10 years 0 months counts as <strong>10 years</strong> for calculation.
                </span>
              </div>
              <span class="font-mono text-[9px] sm:text-[10px] text-[#8f8f8f] uppercase shrink-0">Statutory Rule</span>
            </div>

            <!-- 5-Year Eligibility Guard Card -->
            <div id="eligibility-guard" class="hidden p-3.5 bg-amber-50/90 border border-amber-200 rounded-xl text-xs space-y-2">
              <div class="flex items-start gap-2 text-amber-900 font-medium">
                <span>⚠️</span>
                <span>Tenure under 5 years (<span id="actual-tenure-str">4 yrs</span>)</span>
              </div>
              <p class="text-[11px] text-amber-800 leading-relaxed">
                Standard gratuity requires 5 continuous years. Select an applicable legal exception:
              </p>
              <div class="space-y-1.5 pt-1 text-[11px] text-amber-900">
                <label class="flex items-center gap-2 cursor-pointer select-none py-0.5">
                  <input type="checkbox" id="check-240-days" class="w-4 h-4 rounded text-[#171717]" />
                  <span>Completed 4 years &amp; 240 working days (Treated as 5 years by law)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer select-none py-0.5">
                  <input type="checkbox" id="check-disablement" class="w-4 h-4 rounded text-[#171717]" />
                  <span>Separation due to death or disablement (5-year rule is waived)</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Optional Simulation Accordion -->
          <details class="group pt-2 border-t border-[#f0f0f0]">
            <summary class="text-xs font-medium text-[#8f8f8f] hover:text-[#171717] cursor-pointer flex items-center justify-between select-none py-2 transition-colors min-h-[36px]">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#8f8f8f] group-open:rotate-90 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                Optional Simulation: Actual Received &amp; Future Increment
              </span>
              <span class="font-mono text-[10px]">Expand</span>
            </summary>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 text-xs">
              <div>
                <label for="actual-gratuity-input" class="block text-[#4d4d4d] mb-1 font-medium text-[11px]">
                  Actual Gratuity Received (₹)
                </label>
                <input
                  type="number"
                  id="actual-gratuity-input"
                  min="0"
                  autocomplete="off"
                  placeholder="Auto-calculated from formula"
                  class="w-full px-3 py-2 text-base sm:text-xs bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-[#171717] tabular-nums"
                />
              </div>
              <div>
                <label for="annual-hike-input" class="block text-[#4d4d4d] mb-1 font-medium text-[11px]">
                  Expected Annual Increment (%/yr)
                </label>
                <input
                  type="number"
                  id="annual-hike-input"
                  value="8"
                  min="0"
                  max="100"
                  autocomplete="off"
                  class="w-full px-3 py-2 text-base sm:text-xs bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-[#171717] tabular-nums"
                />
              </div>
            </div>
          </details>

        </div>

        <!-- Right Column: Results Card (5 cols - Sticky) -->
        <div id="results-panel" class="lg:col-span-5 lg:sticky lg:top-24 space-y-3">
          
          <div class="bg-[#fafafa] border border-[#ebebeb] rounded-2xl p-4 sm:p-7 shadow-xs relative overflow-hidden">
            
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] sm:text-[11px] font-semibold uppercase text-[#8f8f8f] tracking-wider">
                Total Gratuity Payable
              </span>
              <span id="result-status-badge" class="font-mono text-[10px] px-2.5 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full font-semibold uppercase">
                Eligible
              </span>
            </div>

            <!-- Big Number Display -->
            <div class="mb-2">
              <div class="flex items-baseline gap-1">
                <span class="font-mono text-2xl sm:text-3xl text-[#8f8f8f] font-semibold">₹</span>
                <span id="result-gratuity-amount" class="text-3xl sm:text-5xl font-bold tracking-tight text-[#171717] break-words tabular-nums">
                  3,46,154
                </span>
              </div>
              <p id="result-in-words" class="text-[11px] text-[#8f8f8f] mt-0.5 capitalize leading-normal">
                Three Lakh Forty-Six Thousand One Hundred Fifty-Four Rupees
              </p>
            </div>

            <div class="my-3.5 border-t border-[#ebebeb]"></div>

            <!-- Tax Exemption Breakdown -->
            <div class="space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="font-mono text-[10px] sm:text-[11px] font-semibold uppercase text-[#171717] flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Sec 10(10) Tax Exemption
                </span>
                <span class="font-mono text-[10px] text-[#8f8f8f]">Cap: ₹20L</span>
              </div>

              <!-- Segmented Progress Bar -->
              <div class="w-full h-2 bg-[#ebebeb] rounded-full overflow-hidden flex">
                <div id="bar-tax-free" class="bg-[#171717] h-full transition-all duration-300" style="width: 100%;"></div>
                <div id="bar-taxable" class="bg-rose-500 h-full transition-all duration-300" style="width: 0%;"></div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs pt-0.5">
                <div class="p-2.5 bg-white border border-[#ebebeb] rounded-xl">
                  <span class="text-[10px] text-[#8f8f8f] block mb-0.5">Tax-Free (Exempt)</span>
                  <span id="tax-free-val" class="font-mono font-bold text-xs sm:text-sm text-emerald-700 tabular-nums">₹3,46,154</span>
                  <span class="block text-[9px] text-emerald-600 font-medium mt-0.5">100% Exempt</span>
                </div>
                <div class="p-2.5 bg-white border border-[#ebebeb] rounded-xl">
                  <span class="text-[10px] text-[#8f8f8f] block mb-0.5">Taxable Portion</span>
                  <span id="taxable-val" class="font-mono font-bold text-xs sm:text-sm text-[#171717] tabular-nums">₹0</span>
                  <span class="block text-[9px] text-[#8f8f8f] font-medium mt-0.5">Normal Slab</span>
                </div>
              </div>
            </div>

            <!-- Formula & Accrual Clean Breakdown -->
            <div class="mt-3.5 pt-3 border-t border-[#ebebeb] space-y-1.5 text-xs">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-[#8f8f8f]">Formula Applied</span>
                <span id="formula-label" class="font-mono text-[#171717] text-right truncate max-w-[210px]">15 × Salary × Years ÷ 26</span>
              </div>
              <p id="formula-substitution" class="text-[10px] text-[#8f8f8f] font-mono text-right truncate tabular-nums">
                (15 × 60,000 × 10) ÷ 26 = ₹3,46,154
              </p>
              <div class="flex items-center justify-between text-[11px] pt-1.5 border-t border-[#f0f0f0]">
                <span class="text-[#8f8f8f]">Annual Accrual</span>
                <span id="metric-per-year" class="font-mono font-semibold text-[#171717] tabular-nums">₹34,615 / yr</span>
              </div>
            </div>

            <!-- Action Buttons (Side by Side on Mobile) -->
            <div class="mt-4 grid grid-cols-2 gap-2">
              <button
                type="button"
                id="btn-print-statement"
                class="py-2.5 px-2.5 rounded-xl bg-[#171717] text-white hover:bg-black font-medium text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-xs min-h-[42px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717] focus-visible:ring-offset-2"
              >
                <svg class="w-3.5 h-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 6 2 18 2 18 9"></polyline>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span class="truncate">Print / PDF</span>
              </button>
              <button
                type="button"
                id="btn-copy-summary"
                class="py-2.5 px-2.5 rounded-xl border border-[#ebebeb] bg-white text-[#171717] hover:bg-[#f5f5f5] font-medium text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-2xs min-h-[42px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717] focus-visible:ring-offset-2"
              >
                <svg class="w-3.5 h-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-btn-label" class="truncate" aria-live="polite">Copy Summary</span>
              </button>
            </div>

          </div>

          <!-- Trust & Statute fact -->
          <div class="px-1 text-[10px] sm:text-[11px] text-[#8f8f8f] leading-normal flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Under Section 13, gratuity cannot be attached by court decree or debt liability.</span>
          </div>

        </div>

      </div>
    </div>

    <!-- Career Milestones Table (Responsive Horizontal Scroll) -->
    <div id="growth-matrix" class="mt-10 sm:mt-14 bg-white/95 backdrop-blur-xl border border-[#ebebeb] rounded-2xl sm:rounded-3xl p-4 sm:p-7 shadow-[0_8px_30px_rgba(0,0,0,0.02)] scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <div>
          <span class="font-mono text-[10px] sm:text-[11px] font-semibold uppercase text-[#8f8f8f] tracking-wider block mb-0.5">
            CAREER PROJECTION FORECAST
          </span>
          <h2 class="text-base sm:text-xl font-semibold tracking-tight text-[#171717]">
            Gratuity Milestones with <span id="matrix-hike-label">8%</span> Annual Increment
          </h2>
        </div>
        <div class="flex items-center gap-3 text-xs text-[#8f8f8f] font-mono">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-500"></span> With Hike</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[#171717]"></span> Fixed</span>
        </div>
      </div>

      <!-- Mobile Scroll Indicator -->
      <div class="sm:hidden text-[10px] text-[#8f8f8f] font-mono mb-2 flex items-center gap-1">
        <span>↔ Scroll horizontally to view milestones</span>
      </div>

      <div class="w-full max-w-full overflow-x-auto rounded-xl border border-[#ebebeb]">
        <table class="w-full text-left text-xs min-w-[500px]" aria-label="Career Milestones projection table">
          <thead>
            <tr class="border-b border-[#ebebeb] text-[#8f8f8f] font-mono uppercase text-[10px]">
              <th class="py-2.5 px-3">Tenure</th>
              <th class="py-2.5 px-3">Projected Salary</th>
              <th class="py-2.5 px-3">Fixed Salary</th>
              <th class="py-2.5 px-3 text-blue-600">With Increments</th>
              <th class="py-2.5 px-3">Tax Status</th>
            </tr>
          </thead>
          <tbody id="projection-table-body" class="divide-y divide-[#f0f0f0]">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>
    </div>
              <th class="py-2.5 px-3">Tax Status</th>
            </tr>
          </thead>
          <tbody id="projection-table-body" class="divide-y divide-[#f0f0f0]">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<!-- Client Script for Interactive Engine -->
<script is:inline>
  (function() {
    const state = {
      category: 'covered',
      salary: 60000,
      years: 10,
      months: 0,
      rule240Days: false,
      ruleDisablement: false,
      actualGratuityOverride: null,
      annualHike: 8
    };

    const tabCovered = document.getElementById('tab-covered');
    const tabNotCovered = document.getElementById('tab-not-covered');
    const tabGovt = document.getElementById('tab-govt');
    const categoryDesc = document.getElementById('category-description-text');
    
    const salaryInput = document.getElementById('salary-input');
    const salarySlider = document.getElementById('salary-slider');
    const presetSalaries = document.querySelectorAll('.preset-salary');
    
    const yearsSlider = document.getElementById('years-slider');
    const monthsSlider = document.getElementById('months-slider');
    const yearsDisplay = document.getElementById('years-display');
    const monthsDisplay = document.getElementById('months-display');
    const effectiveYearsBadge = document.getElementById('effective-years-badge');
    const roundingExplanation = document.getElementById('rounding-explanation');
    
    const eligibilityGuard = document.getElementById('eligibility-guard');
    const actualTenureStr = document.getElementById('actual-tenure-str');
    const check240Days = document.getElementById('check-240-days');
    const checkDisablement = document.getElementById('check-disablement');
    
    const actualGratuityInput = document.getElementById('actual-gratuity-input');
    const annualHikeInput = document.getElementById('annual-hike-input');
    
    const resultGratuity = document.getElementById('result-gratuity-amount');
    const resultInWords = document.getElementById('result-in-words');
    const resultStatusBadge = document.getElementById('result-status-badge');
    
    const taxFreeVal = document.getElementById('tax-free-val');
    const taxableVal = document.getElementById('taxable-val');
    const barTaxFree = document.getElementById('bar-tax-free');
    const barTaxable = document.getElementById('bar-taxable');
    
    const formulaLabel = document.getElementById('formula-label');
    const formulaSubstitution = document.getElementById('formula-substitution');
    const metricPerYear = document.getElementById('metric-per-year');
    
    const projectionTableBody = document.getElementById('projection-table-body');
    const matrixHikeLabel = document.getElementById('matrix-hike-label');

    const toggleCtcHelper = document.getElementById('toggle-ctc-helper');
    const ctcHelperDrawer = document.getElementById('ctc-helper-drawer');
    const helperCtcInput = document.getElementById('helper-ctc-input');
    const applyCtc40 = document.getElementById('apply-ctc-40');
    const applyCtc50 = document.getElementById('apply-ctc-50');

    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copyBtnLabel = document.getElementById('copy-btn-label');
    const btnPrintStatement = document.getElementById('btn-print-statement');

    function formatINR(number) {
      if (isNaN(number)) return "0";
      return new Intl.NumberFormat('en-IN', {
        maximumFractionDigits: 0
      }).format(Math.round(number));
    }

    function numberToWordsINR(num) {
      if (!num || num === 0) return 'Zero Rupees';
      num = Math.round(num);
      const a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen '];
      const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

      function inWords(n) {
        let str = '';
        if (n > 99) {
          str += a[Math.floor(n / 100)] + 'Hundred ';
          n %= 100;
        }
        if (n > 19) {
          str += b[Math.floor(n / 10)] + ' ' + a[n % 10];
        } else if (n > 0) {
          str += a[n];
        }
        return str;
      }

      let res = '';
      const crore = Math.floor(num / 10000000);
      num %= 10000000;
      const lakh = Math.floor(num / 100000);
      num %= 100000;
      const thousand = Math.floor(num / 1000);
      num %= 1000;
      const hundred = num;

      if (crore > 0) res += inWords(crore) + 'Crore ';
      if (lakh > 0) res += inWords(lakh) + 'Lakh ';
      if (thousand > 0) res += inWords(thousand) + 'Thousand ';
      if (hundred > 0) res += inWords(hundred);

      return (res.trim() + ' Rupees');
    }

    function getEffectiveTenure() {
      const y = state.years;
      const m = state.months;
      
      if (state.category === 'covered') {
        const effective = m > 6 ? (y + 1) : y;
        return {
          effectiveYears: effective,
          roundingNote: m > 6 
            ? `Service of ${y} yrs ${m} mos (>6 mos) rounds up to <strong>${effective} years</strong> under Act.`
            : `Service of ${y} yrs ${m} mos is counted as <strong>${effective} completed years</strong>.`
        };
      } else if (state.category === 'not-covered') {
        return {
          effectiveYears: y,
          roundingNote: m > 0 
            ? `Non-covered: fractional months (${m} mos) ignored; <strong>${y} completed years</strong> counted.`
            : `Exact completed service of <strong>${y} years</strong> counted.`
        };
      } else {
        const effective = m >= 6 ? (y + 1) : y;
        return {
          effectiveYears: effective,
          roundingNote: `Government service rounds to <strong>${effective} years</strong>.`
        };
      }
    }

    function calculate() {
      const { effectiveYears, roundingNote } = getEffectiveTenure();
      
      yearsDisplay.textContent = `${state.years} yrs`;
      monthsDisplay.textContent = `${state.months} mos`;
      effectiveYearsBadge.textContent = `Effective: ${effectiveYears} Years`;
      roundingExplanation.innerHTML = roundingNote;

      const isEligible = (state.years >= 5) || state.rule240Days || state.ruleDisablement;
      actualTenureStr.textContent = `${state.years} yrs ${state.months} mos`;

      if (state.years < 5) {
        eligibilityGuard.classList.remove('hidden');
      } else {
        eligibilityGuard.classList.add('hidden');
      }

      if (isEligible) {
        resultStatusBadge.className = "font-mono text-[10px] px-2.5 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full font-semibold uppercase";
        resultStatusBadge.textContent = "Eligible";
      } else {
        resultStatusBadge.className = "font-mono text-[10px] px-2.5 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full font-semibold uppercase";
        resultStatusBadge.textContent = "< 5 Yrs";
      }

      let gratuity = 0;
      let formulaText = "";
      let formulaStep = "";

      if (state.category === 'covered') {
        gratuity = (15 * state.salary * effectiveYears) / 26;
        formulaText = "15 × Salary × Years ÷ 26";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 26 = ₹${formatINR(gratuity)}`;
      } else if (state.category === 'not-covered') {
        gratuity = (15 * state.salary * effectiveYears) / 30;
        formulaText = "15 × Salary × Years ÷ 30";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 30 = ₹${formatINR(gratuity)}`;
      } else {
        gratuity = (15 * state.salary * effectiveYears) / 26;
        formulaText = "Govt Formula (15/26)";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 26 = ₹${formatINR(gratuity)}`;
      }

      const actualReceived = (state.actualGratuityOverride && state.actualGratuityOverride > 0)
        ? state.actualGratuityOverride
        : gratuity;

      let statutoryLimit = state.category === 'govt' ? 2500000 : 2000000;
      let taxFreeAmount = Math.min(actualReceived, statutoryLimit, gratuity);
      let taxableAmount = Math.max(0, actualReceived - taxFreeAmount);

      const formattedGratuity = formatINR(gratuity);
      resultGratuity.textContent = formattedGratuity;
      resultInWords.textContent = numberToWordsINR(gratuity);

      taxFreeVal.textContent = `₹${formatINR(taxFreeAmount)}`;
      taxableVal.textContent = `₹${formatINR(taxableAmount)}`;

      const totalAmountForBar = Math.max(actualReceived, 1);
      const taxFreePct = Math.min(100, Math.max(0, (taxFreeAmount / totalAmountForBar) * 100));
      const taxablePct = 100 - taxFreePct;
      barTaxFree.style.width = `${taxFreePct}%`;
      barTaxable.style.width = `${taxablePct}%`;

      formulaLabel.textContent = formulaText;
      formulaSubstitution.textContent = formulaStep;

      const perYearAccrual = effectiveYears > 0 ? (gratuity / effectiveYears) : 0;
      metricPerYear.textContent = `₹${formatINR(perYearAccrual)} / yr`;

      renderMilestones(state.salary, state.annualHike);
    }

    function renderMilestones(currentSalary, hikePct) {
      if (!projectionTableBody) return;
      matrixHikeLabel.textContent = `${hikePct}%`;
      
      const milestones = [5, 10, 15, 20, 25, 30];
      let html = '';

      milestones.forEach(mYears => {
        let staticGratuity = (state.category === 'not-covered')
          ? (15 * currentSalary * mYears) / 30
          : (15 * currentSalary * mYears) / 26;

        const yearsToMilestone = Math.max(0, mYears - 1);
        const projectedSalary = currentSalary * Math.pow(1 + (hikePct / 100), yearsToMilestone);

        let hikedGratuity = (state.category === 'not-covered')
          ? (15 * projectedSalary * mYears) / 30
          : (15 * projectedSalary * mYears) / 26;

        const isCurrentRange = (state.years >= mYears - 2 && state.years <= mYears + 2);
        const trClass = isCurrentRange ? "bg-[#f5f5f5]/80 font-medium" : "hover:bg-[#fafafa]";
        
        const isCapped = hikedGratuity > 2000000 && state.category !== 'govt';
        const taxBadge = isCapped 
          ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-rose-50 text-rose-700 border border-rose-200">Exceeds ₹20L</span>`
          : `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-50 text-emerald-700 border border-emerald-200">Exempt</span>`;

        html += `
          <tr class="${trClass}">
            <td class="py-3 px-3 sm:px-4 font-mono font-semibold text-[#171717]">
              ${mYears} Yrs ${isCurrentRange ? '<span class="text-[9px] text-blue-600 font-sans ml-0.5 sm:ml-1">(Current)</span>' : ''}
            </td>
            <td class="py-3 px-3 sm:px-4 font-mono text-[#4d4d4d]">
              ₹${formatINR(projectedSalary)}
            </td>
            <td class="py-3 px-3 sm:px-4 font-mono text-[#171717]">
              ₹${formatINR(staticGratuity)}
            </td>
            <td class="py-3 px-3 sm:px-4 font-mono font-semibold text-blue-600">
              ₹${formatINR(hikedGratuity)}
            </td>
            <td class="py-3 px-3 sm:px-4">
              ${taxBadge}
            </td>
          </tr>
        `;
      });

      projectionTableBody.innerHTML = html;
    }

    function setCategory(cat) {
      state.category = cat;
      [tabCovered, tabNotCovered, tabGovt].forEach(btn => {
        btn.className = "category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] min-h-[42px] flex flex-col items-center justify-center";
      });

      if (cat === 'covered') {
        tabCovered.className = "category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs min-h-[42px] flex flex-col items-center justify-center";
        categoryDesc.textContent = "Covered under Act (26 days base)";
      } else if (cat === 'not-covered') {
        tabNotCovered.className = "category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs min-h-[42px] flex flex-col items-center justify-center";
        categoryDesc.textContent = "Not Covered (30 days base)";
      } else {
        tabGovt.className = "category-tab py-2 sm:py-2.5 px-1.5 sm:px-3 text-xs font-medium rounded-lg transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs min-h-[42px] flex flex-col items-center justify-center";
        categoryDesc.textContent = "Government (100% Tax-Free up to ₹25L)";
      }
      calculate();
    }

    tabCovered.addEventListener('click', () => setCategory('covered'));
    tabNotCovered.addEventListener('click', () => setCategory('not-covered'));
    tabGovt.addEventListener('click', () => setCategory('govt'));

    salarySlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      state.salary = val;
      salaryInput.value = formatINR(val);
      calculate();
    });

    salaryInput.addEventListener('input', (e) => {
      const raw = e.target.value.replace(/[^0-9]/g, '');
      const val = parseInt(raw, 10) || 0;
      state.salary = val;
      if (val <= 500000) salarySlider.value = val;
      calculate();
    });

    salaryInput.addEventListener('blur', () => {
      salaryInput.value = formatINR(state.salary);
    });

    presetSalaries.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = parseInt(btn.getAttribute('data-val'), 10);
        state.salary = val;
        salarySlider.value = Math.min(val, 500000);
        salaryInput.value = formatINR(val);
        calculate();
      });
    });

    yearsSlider.addEventListener('input', (e) => {
      state.years = parseInt(e.target.value, 10);
      calculate();
    });

    monthsSlider.addEventListener('input', (e) => {
      state.months = parseInt(e.target.value, 10);
      calculate();
    });

    check240Days.addEventListener('change', (e) => {
      state.rule240Days = e.target.checked;
      calculate();
    });

    checkDisablement.addEventListener('change', (e) => {
      state.ruleDisablement = e.target.checked;
      calculate();
    });

    actualGratuityInput.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      state.actualGratuityOverride = isNaN(val) ? null : val;
      calculate();
    });

    annualHikeInput.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      state.annualHike = isNaN(val) ? 8 : val;
      calculate();
    });

    toggleCtcHelper.addEventListener('click', () => {
      ctcHelperDrawer.classList.toggle('hidden');
    });

    function applyCtc(ratio) {
      const annual = parseFloat(helperCtcInput.value);
      if (!isNaN(annual) && annual > 0) {
        state.salary = Math.round((annual * ratio) / 12);
        salaryInput.value = formatINR(state.salary);
        salarySlider.value = Math.min(state.salary, 500000);
        calculate();
        ctcHelperDrawer.classList.add('hidden');
      }
    }

    applyCtc40.addEventListener('click', () => applyCtc(0.40));
    applyCtc50.addEventListener('click', () => applyCtc(0.50));

    btnPrintStatement.addEventListener('click', () => window.print());

    btnCopySummary.addEventListener('click', async () => {
      const { effectiveYears } = getEffectiveTenure();
      const text = `Gratuity Calculation Summary
----------------------------------------
Employment Category: ${state.category.toUpperCase()}
Monthly Salary (Basic+DA): ₹${formatINR(state.salary)}
Service Tenure: ${state.years} Years, ${state.months} Months (Effective: ${effectiveYears} Years)
Total Gratuity Payable: ₹${resultGratuity.textContent}
Tax-Free Exemption (Sec 10(10)): ${taxFreeVal.textContent}
Taxable Gratuity: ${taxableVal.textContent}
Calculation Formula: ${formulaSubstitution.textContent}
----------------------------------------`;

      await navigator.clipboard.writeText(text);
      copyBtnLabel.textContent = "✓ Copied";
      setTimeout(() => {
        copyBtnLabel.textContent = "Copy Summary";
      }, 2000);
    });

    calculate();
  })();
</script>
