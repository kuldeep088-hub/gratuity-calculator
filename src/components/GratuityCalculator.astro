---
// GratuityCalculator.astro
// Interactive Gratuity Calculator adhering to DESIGN.md
---

<section id="calculator" class="w-full py-8 md:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Hero / Headline -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] leading-[1.1] mb-4">
        Calculate Your Exact Gratuity & Tax Exemption
      </h1>
      <p class="text-[#4d4d4d] text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Accurate formula calculation for both <strong class="font-medium text-[#171717]">Covered</strong> and <strong class="font-medium text-[#171717]">Not Covered</strong> employees, including statutory Section 10(10) limits, service rounding, and future projections.
      </p>
    </div>

    <!-- Main Calculator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Inputs & Configurations (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Category Tab: Covered vs Not Covered vs Govt -->
        <div class="bg-white border border-[#ebebeb] rounded-xl p-5 sm:p-6 shadow-xs">
          <label class="block font-mono text-xs font-semibold uppercase text-[#8f8f8f] tracking-wider mb-3">
            1. Employment Category
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-1 bg-[#f5f5f5] rounded-lg border border-[#ebebeb]">
            <button
              type="button"
              id="tab-covered"
              class="category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs font-sans"
              data-category="covered"
            >
              Covered under Act
              <span class="block text-[10px] text-[#8f8f8f] font-mono mt-0.5">Formula: 15/26</span>
            </button>
            <button
              type="button"
              id="tab-not-covered"
              class="category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] font-sans"
              data-category="not-covered"
            >
              Not Covered
              <span class="block text-[10px] text-[#8f8f8f] font-mono mt-0.5">Formula: 15/30</span>
            </button>
            <button
              type="button"
              id="tab-govt"
              class="category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] font-sans"
              data-category="govt"
            >
              Government
              <span class="block text-[10px] text-[#8f8f8f] font-mono mt-0.5">100% Tax Free</span>
            </button>
          </div>

          <!-- Category Description Context -->
          <div id="category-info-box" class="mt-4 p-3 bg-[#fafafa] rounded-md border border-[#f0f0f0] text-xs text-[#4d4d4d] flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#8f8f8f] shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span id="category-description-text">
              Applies to private establishments, factories, mines, ports, and shops with 10+ employees. Uses 26 working days per month with rounding above 6 months.
            </span>
          </div>
        </div>

        <!-- Monthly Salary Input Card -->
        <div class="bg-white border border-[#ebebeb] rounded-xl p-5 sm:p-6 shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <label for="salary-input" class="block font-medium text-sm text-[#171717]">
                Monthly Salary (Last Drawn Basic + DA)
              </label>
              <p class="text-xs text-[#8f8f8f] mt-0.5">
                Exclude HRA, bonuses, incentives, and special allowances.
              </p>
            </div>
            <!-- Quick CTC helper toggle button -->
            <button
              type="button"
              id="toggle-ctc-helper"
              class="text-xs font-mono text-[#0070f3] hover:underline cursor-pointer flex items-center gap-1"
            >
              CTC Helper
            </button>
          </div>

          <!-- CTC helper drawer (hidden by default) -->
          <div id="ctc-helper-drawer" class="hidden p-3.5 bg-[#f9f9f9] border border-[#ebebeb] rounded-lg text-xs space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="font-medium text-[#171717]">Split Basic from Annual CTC</span>
              <span class="text-[11px] text-[#8f8f8f]">Rule of thumb: 40%–50%</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="text-[11px] text-[#8f8f8f] block mb-1">Annual CTC (₹)</label>
                <input
                  type="number"
                  id="helper-ctc-input"
                  placeholder="e.g. 1200000"
                  class="w-full px-2.5 py-1.5 text-xs bg-white border border-[#ebebeb] rounded-md focus:outline-none focus:border-[#171717]"
                />
              </div>
              <div class="flex items-end gap-1.5">
                <button
                  type="button"
                  id="apply-ctc-40"
                  class="w-1/2 py-1.5 px-2 bg-white border border-[#ebebeb] rounded-md text-[11px] font-medium hover:bg-[#ebebeb] transition-colors"
                >
                  Apply 40%
                </button>
                <button
                  type="button"
                  id="apply-ctc-50"
                  class="w-1/2 py-1.5 px-2 bg-white border border-[#ebebeb] rounded-md text-[11px] font-medium hover:bg-[#ebebeb] transition-colors"
                >
                  Apply 50%
                </button>
              </div>
            </div>
          </div>

          <!-- Salary Input Box & Live Slider -->
          <div class="flex items-center gap-3">
            <div class="relative flex-1">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#8f8f8f] font-mono text-base font-semibold">₹</span>
              <input
                type="text"
                id="salary-input"
                value="60,000"
                class="w-full pl-8 pr-4 py-2.5 text-lg font-semibold tracking-tight text-[#171717] bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:ring-1 focus:ring-[#171717] focus:bg-white transition-all"
              />
            </div>
          </div>

          <!-- Range Slider -->
          <div class="pt-1">
            <input
              type="range"
              id="salary-slider"
              min="10000"
              max="500000"
              step="1000"
              value="60000"
              class="w-full"
            />
            <div class="flex justify-between text-[11px] font-mono text-[#8f8f8f] mt-1.5">
              <span>₹10,000</span>
              <span>₹2,50,000</span>
              <span>₹5,00,000</span>
            </div>
          </div>

          <!-- Preset chips -->
          <div class="flex flex-wrap items-center gap-1.5 pt-1">
            <span class="text-xs text-[#8f8f8f] mr-1">Presets:</span>
            <button type="button" class="preset-salary text-xs font-mono px-2 py-0.5 bg-[#f5f5f5] hover:bg-[#ebebeb] rounded border border-[#e5e5e5] text-[#4d4d4d]" data-val="30000">₹30k</button>
            <button type="button" class="preset-salary text-xs font-mono px-2 py-0.5 bg-[#f5f5f5] hover:bg-[#ebebeb] rounded border border-[#e5e5e5] text-[#4d4d4d]" data-val="50000">₹50k</button>
            <button type="button" class="preset-salary text-xs font-mono px-2 py-0.5 bg-[#f5f5f5] hover:bg-[#ebebeb] rounded border border-[#e5e5e5] text-[#4d4d4d]" data-val="75000">₹75k</button>
            <button type="button" class="preset-salary text-xs font-mono px-2 py-0.5 bg-[#f5f5f5] hover:bg-[#ebebeb] rounded border border-[#e5e5e5] text-[#4d4d4d]" data-val="100000">₹1 Lakh</button>
            <button type="button" class="preset-salary text-xs font-mono px-2 py-0.5 bg-[#f5f5f5] hover:bg-[#ebebeb] rounded border border-[#e5e5e5] text-[#4d4d4d]" data-val="150000">₹1.5 Lakh</button>
          </div>
        </div>

        <!-- Tenure of Service Input Card -->
        <div class="bg-white border border-[#ebebeb] rounded-xl p-5 sm:p-6 shadow-xs space-y-5">
          <div class="flex items-center justify-between">
            <label class="block font-medium text-sm text-[#171717]">
              Total Period of Continuous Service
            </label>
            <span id="effective-years-badge" class="font-mono text-xs px-2 py-0.5 bg-[#f2f2f2] text-[#171717] rounded-md font-semibold">
              Effective: 10 Years
            </span>
          </div>

          <!-- Dual Sliders: Years & Extra Months -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Years -->
            <div class="p-3.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-[#4d4d4d]">Completed Years</span>
                <span id="years-display" class="font-mono font-bold text-sm text-[#171717]">10 yrs</span>
              </div>
              <input
                type="range"
                id="years-slider"
                min="1"
                max="45"
                step="1"
                value="10"
                class="w-full"
              />
              <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f]">
                <span>1 yr</span>
                <span>20 yrs</span>
                <span>45 yrs</span>
              </div>
            </div>

            <!-- Extra Months -->
            <div class="p-3.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-[#4d4d4d]">Additional Months</span>
                <span id="months-display" class="font-mono font-bold text-sm text-[#171717]">0 mos</span>
              </div>
              <input
                type="range"
                id="months-slider"
                min="0"
                max="11"
                step="1"
                value="0"
                class="w-full"
              />
              <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f]">
                <span>0 mos</span>
                <span>6 mos (cutoff)</span>
                <span>11 mos</span>
              </div>
            </div>
          </div>

          <!-- Rounding rule status alert -->
          <div id="rounding-alert-box" class="p-3 bg-[#fafafa] border border-[#ebebeb] rounded-lg text-xs flex items-center justify-between">
            <span id="rounding-explanation" class="text-[#4d4d4d]">
              Service of 10 years 0 months counts as <strong>10 years</strong> for calculation.
            </span>
            <span class="font-mono text-[10px] text-[#8f8f8f] uppercase">Rule Applied</span>
          </div>

          <!-- 5-Year Eligibility Guard Card -->
          <div id="eligibility-guard" class="hidden p-3.5 bg-amber-50/80 border border-amber-200/80 rounded-lg text-xs space-y-2">
            <div class="flex items-start gap-2">
              <span class="text-amber-600 font-bold">⚠️</span>
              <div class="space-y-1">
                <p class="font-medium text-amber-900">
                  Continuous service is under 5 years (<span id="actual-tenure-str">4 yrs</span>)
                </p>
                <p class="text-amber-800 text-[11px] leading-relaxed">
                  Under Section 4(1) of the Gratuity Act, an employee is generally eligible for gratuity only upon completing 5 years of continuous service.
                </p>
              </div>
            </div>
            
            <!-- Exceptions Checklist -->
            <div class="pt-1.5 border-t border-amber-200/60 space-y-1.5">
              <span class="font-mono text-[10px] uppercase font-semibold text-amber-900 block">Applicable Legal Exceptions:</span>
              <label class="flex items-center gap-2 cursor-pointer text-amber-900 select-none">
                <input type="checkbox" id="check-240-days" class="rounded border-amber-300 text-[#171717] focus:ring-0" />
                <span>Completed 4 years &amp; 240 working days (Qualifies as 5 years under judicial rulings)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-amber-900 select-none">
                <input type="checkbox" id="check-disablement" class="rounded border-amber-300 text-[#171717] focus:ring-0" />
                <span>Termination caused by death or permanent disablement (5-year rule is waived)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Advanced Projection & Ex-Gratia Accordion -->
        <details class="group bg-white border border-[#ebebeb] rounded-xl p-5 shadow-xs">
          <summary class="font-medium text-sm text-[#171717] cursor-pointer flex items-center justify-between select-none">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#8f8f8f] group-open:rotate-90 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
              Advanced Simulation: Future Hike &amp; Actual Received
            </span>
            <span class="font-mono text-[11px] text-[#8f8f8f]">Optional</span>
          </summary>
          
          <div class="pt-4 mt-3 border-t border-[#f0f0f0] space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Actual Amount Received (for taxable calculation check) -->
              <div>
                <label for="actual-gratuity-input" class="block font-medium text-[#171717] mb-1">
                  Actual Gratuity Received (if different)
                </label>
                <div class="relative">
                  <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[#8f8f8f] font-mono">₹</span>
                  <input
                    type="number"
                    id="actual-gratuity-input"
                    placeholder="Auto-calculated from formula"
                    class="w-full pl-6 pr-3 py-1.5 text-xs bg-[#fafafa] border border-[#ebebeb] rounded-md focus:outline-none focus:border-[#171717]"
                  />
                </div>
                <p class="text-[10px] text-[#8f8f8f] mt-1">
                  Leave blank to use the statutory formula amount.
                </p>
              </div>

              <!-- Annual Expected Salary Hike % -->
              <div>
                <label for="annual-hike-input" class="block font-medium text-[#171717] mb-1">
                  Expected Annual Salary Increment (%)
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="annual-hike-input"
                    value="8"
                    min="0"
                    max="30"
                    class="w-full pl-3 pr-7 py-1.5 text-xs bg-[#fafafa] border border-[#ebebeb] rounded-md focus:outline-none focus:border-[#171717]"
                  />
                  <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[#8f8f8f] font-mono">%</span>
                </div>
                <p class="text-[10px] text-[#8f8f8f] mt-1">
                  Used for computing career milestone projections below.
                </p>
              </div>
            </div>
          </div>
        </details>

      </div>

      <!-- Right Column: Results & Exemption Card (5 cols - Sticky) -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-5">
        
        <!-- Primary Result Card (Vercel Style) -->
        <div class="bg-white border border-[#ebebeb] rounded-xl p-6 shadow-sm relative overflow-hidden">
          
          <!-- Subtle top accent bar -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#007cf0] via-[#7928ca] to-[#ff0080]"></div>

          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-semibold uppercase text-[#8f8f8f] tracking-wider">
              Total Gratuity Payable
            </span>
            <span id="result-status-badge" class="font-mono text-[10px] px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded font-semibold uppercase">
              Eligible
            </span>
          </div>

          <!-- Big Currency Output -->
          <div class="mb-1">
            <div class="flex items-baseline gap-1">
              <span class="font-mono text-2xl text-[#8f8f8f] font-semibold">₹</span>
              <span id="result-gratuity-amount" class="text-4xl sm:text-5xl font-bold tracking-tight text-[#171717]">
                3,46,154
              </span>
            </div>
            <p id="result-in-words" class="text-xs text-[#8f8f8f] mt-1 capitalize leading-tight">
              Three Lakh Forty-Six Thousand One Hundred Fifty-Four Rupees
            </p>
          </div>

          <!-- Divider -->
          <div class="my-5 border-t border-[#f0f0f0]"></div>

          <!-- Tax Exemption Section 10(10) Breakdown -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-semibold uppercase text-[#171717] tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Tax Exemption (Sec 10(10))
              </span>
              <span class="font-mono text-[11px] text-[#8f8f8f]">Limit: ₹20 Lakh</span>
            </div>

            <!-- Segmented Progress Bar -->
            <div class="w-full h-3 bg-[#f0f0f0] rounded-full overflow-hidden flex">
              <div id="bar-tax-free" class="bg-[#171717] h-full transition-all duration-300" style="width: 100%;"></div>
              <div id="bar-taxable" class="bg-rose-500 h-full transition-all duration-300" style="width: 0%;"></div>
            </div>

            <!-- Details: Tax Free vs Taxable -->
            <div class="grid grid-cols-2 gap-3 pt-1">
              <div class="p-3 bg-[#fafafa] border border-[#ebebeb] rounded-lg">
                <span class="text-[11px] text-[#8f8f8f] block mb-0.5">Tax-Free Amount</span>
                <span id="tax-free-val" class="font-mono font-bold text-sm text-emerald-700">₹3,46,154</span>
                <span class="block text-[10px] text-emerald-600 font-medium mt-0.5">100% Exempt</span>
              </div>
              <div class="p-3 bg-[#fafafa] border border-[#ebebeb] rounded-lg">
                <span class="text-[11px] text-[#8f8f8f] block mb-0.5">Taxable Component</span>
                <span id="taxable-val" class="font-mono font-bold text-sm text-[#171717]">₹0</span>
                <span class="block text-[10px] text-[#8f8f8f] font-medium mt-0.5">Subject to slab</span>
              </div>
            </div>
          </div>

          <!-- Formula Substitution Display -->
          <div class="mt-5 p-3.5 bg-[#f9f9f9] border border-[#ebebeb] rounded-lg space-y-1.5">
            <div class="flex items-center justify-between text-[11px] font-mono text-[#8f8f8f]">
              <span>CALCULATION STEP</span>
              <span id="formula-label">15 × Salary × Years ÷ 26</span>
            </div>
            <p id="formula-substitution" class="font-mono text-xs font-semibold text-[#171717] break-all">
              (15 × 60,000 × 10) ÷ 26 = ₹3,46,154
            </p>
          </div>

          <!-- Key Metrics Grid -->
          <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
            <div class="py-1 px-2 bg-white rounded border border-[#f0f0f0] flex justify-between">
              <span class="text-[#8f8f8f]">Per Year Accrual:</span>
              <span id="metric-per-year" class="font-mono font-medium text-[#171717]">₹34,615</span>
            </div>
            <div class="py-1 px-2 bg-white rounded border border-[#f0f0f0] flex justify-between">
              <span class="text-[#8f8f8f]">Daily Wage Base:</span>
              <span id="metric-daily-wage" class="font-mono font-medium text-[#171717]">₹2,308</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="mt-6 flex flex-col sm:flex-row items-center gap-2.5">
            <button
              type="button"
              id="btn-print-statement"
              class="w-full sm:flex-1 py-2.5 px-4 rounded-full bg-[#171717] text-white hover:bg-black font-medium text-xs flex items-center justify-center gap-2 transition-all cursor-pointer shadow-xs"
            >
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              Print / Save PDF
            </button>
            <button
              type="button"
              id="btn-copy-summary"
              class="w-full sm:w-auto py-2.5 px-4 rounded-full border border-[#ebebeb] bg-white text-[#171717] hover:bg-[#f5f5f5] font-medium text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-btn-label">Copy Summary</span>
            </button>
          </div>

        </div>

        <!-- Trust & Law Fact Card -->
        <div class="bg-white border border-[#ebebeb] rounded-xl p-4 text-xs text-[#4d4d4d] space-y-1.5">
          <div class="flex items-center gap-1.5 font-medium text-[#171717]">
            <svg class="w-3.5 h-3.5 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Statutory Legal Protections
          </div>
          <p class="text-[11px] text-[#8f8f8f] leading-relaxed">
            Gratuity cannot be attached by any court decree or debt recovery under Section 13 of the Payment of Gratuity Act 1972. It is guaranteed money owed for your service.
          </p>
        </div>

      </div>

    </div>

    <!-- Career Milestone Accumulation Matrix (Unique Feature that blows away Groww) -->
    <div id="growth-matrix" class="mt-14 bg-white border border-[#ebebeb] rounded-xl p-6 sm:p-8 shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
          <span class="font-mono text-xs font-semibold uppercase text-[#8f8f8f] tracking-wider block mb-1">
            CAREER ROADMAP &amp; FUTURE WEALTH
          </span>
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717]">
            Gratuity Accumulation Milestone Forecast
          </h2>
          <p class="text-xs text-[#4d4d4d] mt-1">
            Comparing static basic salary with a projected <span id="matrix-hike-label" class="font-semibold text-[#171717]">8%</span> annual increment across your career.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-[#8f8f8f] font-mono">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span> With Hike
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-[#8f8f8f] font-mono ml-2">
            <span class="w-2 h-2 rounded-full bg-[#171717]"></span> Fixed Salary
          </span>
        </div>
      </div>

      <!-- Forecast Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-[#ebebeb] text-[#8f8f8f] font-mono uppercase text-[11px]">
              <th class="py-3 px-3">Service Milestone</th>
              <th class="py-3 px-3">Projected Monthly Basic</th>
              <th class="py-3 px-3">Gratuity (Static Salary)</th>
              <th class="py-3 px-3">Gratuity (With Increments)</th>
              <th class="py-3 px-3">Tax Status</th>
            </tr>
          </thead>
          <tbody id="projection-table-body" class="divide-y divide-[#f0f0f0]">
            <!-- Populated via JavaScript dynamically -->
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<!-- Client Script for Interactive Engine -->
<script is:inline>
  (function() {
    // State
    const state = {
      category: 'covered', // 'covered', 'not-covered', 'govt'
      salary: 60000,
      years: 10,
      months: 0,
      rule240Days: false,
      ruleDisablement: false,
      actualGratuityOverride: null,
      annualHike: 8
    };

    // DOM Elements
    const tabCovered = document.getElementById('tab-covered');
    const tabNotCovered = document.getElementById('tab-not-covered');
    const tabGovt = document.getElementById('tab-govt');
    const categoryDesc = document.getElementById('category-description-text');
    
    const salaryInput = document.getElementById('salary-input');
    const salarySlider = document.getElementById('salary-slider');
    const presetSalaries = document.querySelectorAll('.preset-salary');
    
    const yearsSlider = document.getElementById('years-slider');
    const monthsSlider = document.getElementById('months-slider');
    const yearsDisplay = document.getElementById('years-display');
    const monthsDisplay = document.getElementById('months-display');
    const effectiveYearsBadge = document.getElementById('effective-years-badge');
    const roundingExplanation = document.getElementById('rounding-explanation');
    
    const eligibilityGuard = document.getElementById('eligibility-guard');
    const actualTenureStr = document.getElementById('actual-tenure-str');
    const check240Days = document.getElementById('check-240-days');
    const checkDisablement = document.getElementById('check-disablement');
    
    const actualGratuityInput = document.getElementById('actual-gratuity-input');
    const annualHikeInput = document.getElementById('annual-hike-input');
    
    const resultGratuity = document.getElementById('result-gratuity-amount');
    const resultInWords = document.getElementById('result-in-words');
    const resultStatusBadge = document.getElementById('result-status-badge');
    
    const taxFreeVal = document.getElementById('tax-free-val');
    const taxableVal = document.getElementById('taxable-val');
    const barTaxFree = document.getElementById('bar-tax-free');
    const barTaxable = document.getElementById('bar-taxable');
    
    const formulaLabel = document.getElementById('formula-label');
    const formulaSubstitution = document.getElementById('formula-substitution');
    const metricPerYear = document.getElementById('metric-per-year');
    const metricDailyWage = document.getElementById('metric-daily-wage');
    
    const projectionTableBody = document.getElementById('projection-table-body');
    const matrixHikeLabel = document.getElementById('matrix-hike-label');

    const toggleCtcHelper = document.getElementById('toggle-ctc-helper');
    const ctcHelperDrawer = document.getElementById('ctc-helper-drawer');
    const helperCtcInput = document.getElementById('helper-ctc-input');
    const applyCtc40 = document.getElementById('apply-ctc-40');
    const applyCtc50 = document.getElementById('apply-ctc-50');

    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copyBtnLabel = document.getElementById('copy-btn-label');
    const btnPrintStatement = document.getElementById('btn-print-statement');

    // Indian Number Formatter
    function formatINR(number) {
      if (isNaN(number)) return "0";
      return new Intl.NumberFormat('en-IN', {
        maximumFractionDigits: 0
      }).format(Math.round(number));
    }

    // Number to Words in Indian numbering system
    function numberToWordsINR(num) {
      if (!num || num === 0) return 'Zero Rupees';
      num = Math.round(num);
      
      const a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen '];
      const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

      function inWords(n) {
        let str = '';
        if (n > 99) {
          str += a[Math.floor(n / 100)] + 'Hundred ';
          n %= 100;
        }
        if (n > 19) {
          str += b[Math.floor(n / 10)] + ' ' + a[n % 10];
        } else if (n > 0) {
          str += a[n];
        }
        return str;
      }

      let res = '';
      const crore = Math.floor(num / 10000000);
      num %= 10000000;
      const lakh = Math.floor(num / 100000);
      num %= 100000;
      const thousand = Math.floor(num / 1000);
      num %= 1000;
      const hundred = num;

      if (crore > 0) res += inWords(crore) + 'Crore ';
      if (lakh > 0) res += inWords(lakh) + 'Lakh ';
      if (thousand > 0) res += inWords(thousand) + 'Thousand ';
      if (hundred > 0) res += inWords(hundred);

      return (res.trim() + ' Rupees');
    }

    // Compute Effective Tenure based on law
    function getEffectiveTenure() {
      const y = state.years;
      const m = state.months;
      
      if (state.category === 'covered') {
        // Covered Act: > 6 months rounds up to 1 year
        const effective = m > 6 ? (y + 1) : y;
        return {
          effectiveYears: effective,
          roundingNote: m > 6 
            ? `Service of ${y} yrs ${m} mos (>6 mos) rounds up to ${effective} years under the Gratuity Act.`
            : `Service of ${y} yrs ${m} mos (≤6 mos) is counted as ${effective} completed years.`
        };
      } else if (state.category === 'not-covered') {
        // Not covered: Only completed full years are counted
        return {
          effectiveYears: y,
          roundingNote: m > 0 
            ? `Under non-covered rules, fractional months (${m} mos) are ignored. Only ${y} completed years are counted.`
            : `Exact completed service of ${y} years counted.`
        };
      } else {
        // Government
        const effective = m >= 6 ? (y + 1) : y;
        return {
          effectiveYears: effective,
          roundingNote: `Government service of ${y} yrs ${m} mos rounds to ${effective} years.`
        };
      }
    }

    // Main Calculator logic
    function calculate() {
      const { effectiveYears, roundingNote } = getEffectiveTenure();
      
      // Update tenure UI
      yearsDisplay.textContent = `${state.years} yrs`;
      monthsDisplay.textContent = `${state.months} mos`;
      effectiveYearsBadge.textContent = `Effective: ${effectiveYears} Years`;
      roundingExplanation.innerHTML = roundingNote;

      // Check 5-year eligibility
      const isEligible = (state.years >= 5) || state.rule240Days || state.ruleDisablement;
      actualTenureStr.textContent = `${state.years} yrs ${state.months} mos`;

      if (state.years < 5) {
        eligibilityGuard.classList.remove('hidden');
      } else {
        eligibilityGuard.classList.add('hidden');
      }

      if (isEligible) {
        resultStatusBadge.className = "font-mono text-[10px] px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded font-semibold uppercase";
        resultStatusBadge.textContent = "Eligible";
      } else {
        resultStatusBadge.className = "font-mono text-[10px] px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded font-semibold uppercase";
        resultStatusBadge.textContent = "Tenure < 5 Yrs";
      }

      let gratuity = 0;
      let formulaText = "";
      let formulaStep = "";
      let dailyWage = 0;

      if (state.category === 'covered') {
        // G = (15 * Salary * N) / 26
        dailyWage = state.salary / 26;
        gratuity = (15 * state.salary * effectiveYears) / 26;
        formulaText = "15 × Salary × Years ÷ 26";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 26 = ₹${formatINR(gratuity)}`;
      } else if (state.category === 'not-covered') {
        // G = (15 * Salary * N) / 30 = 0.5 * Salary * N
        dailyWage = state.salary / 30;
        gratuity = (15 * state.salary * effectiveYears) / 30;
        formulaText = "15 × 10-mo Avg Salary × Completed Years ÷ 30";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 30 = ₹${formatINR(gratuity)}`;
      } else {
        // Govt: 1/4 of a month's emoluments for each completed 6-monthly period (approx 15/26 or 16.5 months ceiling)
        dailyWage = state.salary / 26;
        gratuity = (15 * state.salary * effectiveYears) / 26;
        formulaText = "Government Pension Formula (15/26)";
        formulaStep = `(15 × ₹${formatINR(state.salary)} × ${effectiveYears}) ÷ 26 = ₹${formatINR(gratuity)}`;
      }

      // If user provided override for actual gratuity received
      const actualReceived = (state.actualGratuityOverride && state.actualGratuityOverride > 0)
        ? state.actualGratuityOverride
        : gratuity;

      // Tax exemption limits under Section 10(10)
      // Covered & Non-covered: Statutory ceiling is 20 Lakhs (20,00,000)
      // Govt: 100% exempt up to 25 Lakhs
      let statutoryLimit = 2000000;
      if (state.category === 'govt') statutoryLimit = 2500000;

      let taxFreeAmount = 0;
      let taxableAmount = 0;

      if (state.category === 'govt') {
        taxFreeAmount = Math.min(actualReceived, statutoryLimit);
        taxableAmount = Math.max(0, actualReceived - taxFreeAmount);
      } else {
        // Section 10(10): Least of:
        // 1. Actual received
        // 2. Statutory limit (20,00,000)
        // 3. Formula calculated amount
        const eligibleExempt = Math.min(actualReceived, statutoryLimit, gratuity);
        taxFreeAmount = eligibleExempt;
        taxableAmount = Math.max(0, actualReceived - taxFreeAmount);
      }

      // Update primary displays
      resultGratuity.textContent = formatINR(gratuity);
      resultInWords.textContent = numberToWordsINR(gratuity);

      taxFreeVal.textContent = `₹${formatINR(taxFreeAmount)}`;
      taxableVal.textContent = `₹${formatINR(taxableAmount)}`;

      // Update bar widths
      const totalAmountForBar = Math.max(actualReceived, 1);
      const taxFreePct = Math.min(100, Math.max(0, (taxFreeAmount / totalAmountForBar) * 100));
      const taxablePct = 100 - taxFreePct;
      barTaxFree.style.width = `${taxFreePct}%`;
      barTaxable.style.width = `${taxablePct}%`;

      // Update formula
      formulaLabel.textContent = formulaText;
      formulaSubstitution.textContent = formulaStep;

      // Update metrics
      const perYearAccrual = effectiveYears > 0 ? (gratuity / effectiveYears) : 0;
      metricPerYear.textContent = `₹${formatINR(perYearAccrual)}`;
      metricDailyWage.textContent = `₹${formatINR(dailyWage)}`;

      // Render Career Milestones Table
      renderMilestones(state.salary, state.annualHike);
    }

    // Render Milestone Forecast Table
    function renderMilestones(currentSalary, hikePct) {
      if (!projectionTableBody) return;
      matrixHikeLabel.textContent = `${hikePct}%`;
      
      const milestones = [5, 10, 15, 20, 25, 30];
      let html = '';

      milestones.forEach(mYears => {
        // Static salary calculation
        let staticGratuity = 0;
        if (state.category === 'covered' || state.category === 'govt') {
          staticGratuity = (15 * currentSalary * mYears) / 26;
        } else {
          staticGratuity = (15 * currentSalary * mYears) / 30;
        }

        // Project salary with compound interest: S_n = S_0 * (1 + r)^n
        // Assume current tenure is state.years, so extra years to milestone = max(0, mYears - state.years)
        const yearsToMilestone = Math.max(0, mYears - 1);
        const projectedSalary = currentSalary * Math.pow(1 + (hikePct / 100), yearsToMilestone);

        let hikedGratuity = 0;
        if (state.category === 'covered' || state.category === 'govt') {
          hikedGratuity = (15 * projectedSalary * mYears) / 26;
        } else {
          hikedGratuity = (15 * projectedSalary * mYears) / 30;
        }

        const isCurrentRange = (state.years >= mYears - 2 && state.years <= mYears + 2);
        const trClass = isCurrentRange ? "bg-[#f5f5f5]/80 font-medium" : "hover:bg-[#fafafa]";
        
        const isCapped = hikedGratuity > 2000000 && state.category !== 'govt';
        const taxBadge = isCapped 
          ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-rose-50 text-rose-700 border border-rose-200">Exceeds ₹20L</span>`
          : `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-emerald-50 text-emerald-700 border border-emerald-200">100% Tax-Free</span>`;

        html += `
          <tr class="${trClass}">
            <td class="py-3 px-3">
              <span class="font-mono font-semibold text-[#171717]">${mYears} Years</span>
              ${isCurrentRange ? '<span class="ml-1 text-[10px] text-blue-600 font-mono">(Near You)</span>' : ''}
            </td>
            <td class="py-3 px-3 font-mono text-[#4d4d4d]">
              ₹${formatINR(projectedSalary)}
            </td>
            <td class="py-3 px-3 font-mono text-[#171717]">
              ₹${formatINR(staticGratuity)}
            </td>
            <td class="py-3 px-3 font-mono font-semibold text-blue-600">
              ₹${formatINR(hikedGratuity)}
            </td>
            <td class="py-3 px-3">
              ${taxBadge}
            </td>
          </tr>
        `;
      });

      projectionTableBody.innerHTML = html;
    }

    // Event Listeners for Tabs
    function setCategory(cat) {
      state.category = cat;
      [tabCovered, tabNotCovered, tabGovt].forEach(btn => {
        btn.className = "category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer text-[#4d4d4d] hover:text-[#171717] font-sans";
      });

      if (cat === 'covered') {
        tabCovered.className = "category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs font-sans";
        categoryDesc.textContent = "Applies to private establishments, factories, mines, ports, and shops with 10+ employees. Uses 26 working days per month with rounding above 6 months.";
      } else if (cat === 'not-covered') {
        tabNotCovered.className = "category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs font-sans";
        categoryDesc.textContent = "Applies to organizations not covered under the Gratuity Act. Uses 30 days per month (half-month salary per year). Fractional months are ignored.";
      } else {
        tabGovt.className = "category-tab py-2.5 px-3 text-xs font-medium rounded-md transition-all text-center cursor-pointer bg-white text-[#171717] shadow-2xs font-sans";
        categoryDesc.textContent = "Central & State Government, Defense, and Local Authority employees. 100% exempt from income tax up to ₹25 Lakhs.";
      }
      calculate();
    }

    tabCovered.addEventListener('click', () => setCategory('covered'));
    tabNotCovered.addEventListener('click', () => setCategory('not-covered'));
    tabGovt.addEventListener('click', () => setCategory('govt'));

    // Salary Input & Slider synchronization
    salarySlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      state.salary = val;
      salaryInput.value = formatINR(val);
      calculate();
    });

    salaryInput.addEventListener('input', (e) => {
      const raw = e.target.value.replace(/[^0-9]/g, '');
      const val = parseInt(raw, 10) || 0;
      state.salary = val;
      if (val <= 500000) {
        salarySlider.value = val;
      }
      calculate();
    });

    salaryInput.addEventListener('blur', (e) => {
      salaryInput.value = formatINR(state.salary);
    });

    // Preset salary chips
    presetSalaries.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = parseInt(btn.getAttribute('data-val'), 10);
        state.salary = val;
        salarySlider.value = Math.min(val, 500000);
        salaryInput.value = formatINR(val);
        calculate();
      });
    });

    // Tenure sliders
    yearsSlider.addEventListener('input', (e) => {
      state.years = parseInt(e.target.value, 10);
      calculate();
    });

    monthsSlider.addEventListener('input', (e) => {
      state.months = parseInt(e.target.value, 10);
      calculate();
    });

    // Checkboxes
    check240Days.addEventListener('change', (e) => {
      state.rule240Days = e.target.checked;
      calculate();
    });

    checkDisablement.addEventListener('change', (e) => {
      state.ruleDisablement = e.target.checked;
      calculate();
    });

    // Advanced inputs
    actualGratuityInput.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      state.actualGratuityOverride = isNaN(val) ? null : val;
      calculate();
    });

    annualHikeInput.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      state.annualHike = isNaN(val) ? 8 : val;
      calculate();
    });

    // CTC Helper Drawer
    toggleCtcHelper.addEventListener('click', () => {
      ctcHelperDrawer.classList.toggle('hidden');
    });

    function applyCtc(ratio) {
      const annual = parseFloat(helperCtcInput.value);
      if (!isNaN(annual) && annual > 0) {
        const monthlyBasic = (annual * ratio) / 12;
        state.salary = Math.round(monthlyBasic);
        salaryInput.value = formatINR(state.salary);
        salarySlider.value = Math.min(state.salary, 500000);
        calculate();
        ctcHelperDrawer.classList.add('hidden');
      }
    }

    applyCtc40.addEventListener('click', () => applyCtc(0.40));
    applyCtc50.addEventListener('click', () => applyCtc(0.50));

    // Print & PDF
    btnPrintStatement.addEventListener('click', () => {
      window.print();
    });

    // Copy Summary
    btnCopySummary.addEventListener('click', async () => {
      const { effectiveYears } = getEffectiveTenure();
      const text = `Gratuity Calculation Summary (freegratuitycalculator.com)
----------------------------------------
Employment Category: ${state.category.toUpperCase()}
Monthly Salary (Basic+DA): ₹${formatINR(state.salary)}
Service Tenure: ${state.years} Years, ${state.months} Months (Effective: ${effectiveYears} Years)
Total Gratuity Payable: ₹${resultGratuity.textContent}
Tax-Free Exemption (Sec 10(10)): ${taxFreeVal.textContent}
Taxable Gratuity: ${taxableVal.textContent}
Calculation Formula: ${formulaSubstitution.textContent}
----------------------------------------
Generated at https://freegratuitycalculator.com`;

      await navigator.clipboard.writeText(text);
      copyBtnLabel.textContent = "✓ Copied!";
      setTimeout(() => {
        copyBtnLabel.textContent = "Copy Summary";
      }, 2000);
    });

    // Initial calculation on load
    calculate();
  })();
</script>
