---
---
<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] bg-[#fafafa]/80 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center font-mono font-bold text-sm tracking-tight shadow-xs group-hover:scale-105 transition-transform">
        ₹G
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-base tracking-tight text-[#171717] group-hover:text-black">
          Gratuity Calculator
        </span>
        <span class="font-mono text-[10px] uppercase text-[#8f8f8f] tracking-wider -mt-1 hidden sm:block">
          freegratuitycalculator.com
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-[#4d4d4d]">
      <a href="#calculator" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#f2f2f2] transition-colors">
        Calculator
      </a>
      <a href="#comparison" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#f2f2f2] transition-colors">
        Covered vs Non-Covered
      </a>
      <a href="#taxation" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#f2f2f2] transition-colors">
        Sec 10(10) Tax Exemption
      </a>
      <a href="#growth-matrix" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#f2f2f2] transition-colors">
        Growth Matrix
      </a>
      <a href="#faqs" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#f2f2f2] transition-colors">
        FAQs
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        id="header-share-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-[#ebebeb] bg-white text-[#171717] hover:bg-[#f5f5f5] hover:border-[#d4d4d4] transition-all cursor-pointer shadow-2xs"
        title="Share this calculator"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span class="hidden sm:inline">Share</span>
      </button>

      <a
        href="#calculator"
        class="inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-medium rounded-full bg-[#171717] text-white hover:bg-black transition-all shadow-xs"
      >
        Calculate Now
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const shareBtn = document.getElementById('header-share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'Free Gratuity Calculator India',
            text: 'Accurately calculate Gratuity payout with tax exemptions for Covered and Non-Covered employees.',
            url: window.location.href,
          });
        } catch (e) {
          // ignore share cancellations
        }
      } else {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = shareBtn.innerHTML;
        shareBtn.innerHTML = '<span>✓ Copied URL!</span>';
        setTimeout(() => {
          shareBtn.innerHTML = originalText;
        }, 2000);
      }
    });
  }
</script>
