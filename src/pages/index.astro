---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GratuityCalculator from '../components/GratuityCalculator.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import TaxationGuide from '../components/TaxationGuide.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Gratuity Calculator India 2025–26 | Covered & Non-Covered with Tax Exemption"
  description="Accurately compute gratuity payout, statutory tax exemptions (Section 10(10)), service tenure rounding, and future salary projections for employees covered and not covered under the Gratuity Act 1972."
>
  <!-- Calm Ethereal Background with Subtle Mesh Aura and Delicate Dot Grid -->
  <div class="relative min-h-screen flex flex-col">
    
    <!-- Background Calm Dot Grid Layer -->
    <div class="calm-dot-grid absolute inset-0 pointer-events-none opacity-40 [mask-image:radial-gradient(ellipse_at_top,white_20%,transparent_75%)] -z-20"></div>

    <!-- Soft Ambient Mesh Glow Layer (Hero Aura) -->
    <div 
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[500px] opacity-20 pointer-events-none blur-[90px] -z-10"
      style="background: radial-gradient(circle at 30% 25%, #007cf0 0%, transparent 45%), radial-gradient(circle at 50% 20%, #7928ca 0%, transparent 50%), radial-gradient(circle at 70% 30%, #50e3c2 0%, transparent 40%), radial-gradient(circle at 50% 70%, #00dfd8 0%, transparent 55%);"
    ></div>

    <Header />
    <main class="flex-1">
      <GratuityCalculator />
      <ComparisonTable />
      <TaxationGuide />
      <FaqSection />
    </main>
    <Footer />
  </div>
</Layout>
